(* rMath demonstration file.

   Load it from the notebook or REPL with:

       Get["demo/demo.mt"]

   A file evaluated with Get does not echo intermediate values, so every step
   prints its own result. The sections follow the kernel's feature areas and
   every example here has been checked against the kernel. The final expression
   is returned, so the notebook renders it as a picture. *)

Print["rMath demonstration — ", Length[Names["*"]], " symbols available"]

Print["== 1. exact and numeric arithmetic =="]
Print["  1/2 + 1/3  =  ", 1/2 + 1/3]
Print["  1/3 + 1/6 + 1/2  =  ", 1/3 + 1/6 + 1/2]
Print["  2^100  =  ", 2^100]
Print["  Factorial[20]  =  ", Factorial[20]]
Print["  20!  =  ", 20!]
Print["  GCD[24, 36]  =  ", GCD[24, 36]]
Print["  LCM[4, 6]  =  ", LCM[4, 6]]
Print["  Quotient[17, 5]  =  ", Quotient[17, 5]]
Print["  Mod[17, 5]  =  ", Mod[17, 5]]
Print["  Abs[-7]  =  ", Abs[-7]]
Print["  Sign[-3]  =  ", Sign[-3]]
Print["  Floor[7/2]  =  ", Floor[7/2]]
Print["  Ceiling[7/2]  =  ", Ceiling[7/2]]
Print["  Round[7/2]  =  ", Round[7/2]]
Print["  Round[1/2]  =  ", Round[1/2]]
Print["  Round[5/2]  =  ", Round[5/2]]
Print["  IntegerPart[7/2]  =  ", IntegerPart[7/2]]
Print["  FractionalPart[7/2]  =  ", FractionalPart[7/2]]
Print["  Numerator[6/8]  =  ", Numerator[6/8]]
Print["  Denominator[6/8]  =  ", Denominator[6/8]]
Print["  Rational[2, 4]  =  ", Rational[2, 4]]
Print["  Sqrt[16]  =  ", Sqrt[16]]
Print["  Sqrt[8]  =  ", Sqrt[8]]
Print["  Sqrt[-4]  =  ", Sqrt[-4]]
Print["  N[Pi]  =  ", N[Pi]]
Print["  N[E]  =  ", N[E]]
Print["  N[Sqrt[2]]  =  ", N[Sqrt[2]]]
Print["  N[1/7]  =  ", N[1/7]]
Print["== 2. complex numbers =="]
Print["  I^2  =  ", I^2]
Print["  3 I  =  ", 3 I]
Print["  1 + I  =  ", 1 + I]
Print["  (1 + I)(1 - I)  =  ", (1 + I)(1 - I)]
Print["  (2 + 3 I)(1 - I)  =  ", (2 + 3 I)(1 - I)]
Print["  (1 + I)^2  =  ", (1 + I)^2]
Print["  Complex[1, 2]^2  =  ", Complex[1, 2]^2]
Print["  Re[3 + 4 I]  =  ", Re[3 + 4 I]]
Print["  Im[3 + 4 I]  =  ", Im[3 + 4 I]]
Print["  Conjugate[3 + 4 I]  =  ", Conjugate[3 + 4 I]]
Print["  Abs[3 + 4 I]  =  ", Abs[3 + 4 I]]
Print["  Complex[2, -3]  =  ", Complex[2, -3]]
Print["  1/I  =  ", 1/I]
Print["  Re[(2 + 3 I)^-1]  =  ", Re[(2 + 3 I)^-1]]
Print["  Im[(2 + 3 I)^-1]  =  ", Im[(2 + 3 I)^-1]]
Print["== 3. elementary functions =="]
Print["  Exp[1]  =  ", Exp[1]]
Print["  Exp[0]  =  ", Exp[0]]
Print["  Log[E]  =  ", Log[E]]
Print["  Log[1]  =  ", Log[1]]
Print["  Log[8, 2]  =  ", Log[8, 2]]
Print["  Sin[0]  =  ", Sin[0]]
Print["  Cos[0]  =  ", Cos[0]]
Print["  Tan[0]  =  ", Tan[0]]
Print["  Sin[Pi/6]  =  ", Sin[Pi/6]]
Print["  Cos[Pi/3]  =  ", Cos[Pi/3]]
Print["  Sinh[0]  =  ", Sinh[0]]
Print["  Cosh[0]  =  ", Cosh[0]]
Print["  Tanh[0]  =  ", Tanh[0]]
Print["  Cot[Pi/4]  =  ", Cot[Pi/4]]
Print["  Sec[0]  =  ", Sec[0]]
Print["  Csc[Pi/2]  =  ", Csc[Pi/2]]
Print["  ArcSin[1]  =  ", ArcSin[1]]
Print["  ArcCos[1]  =  ", ArcCos[1]]
Print["  ArcTan[1]  =  ", ArcTan[1]]
Print["  N[ArcTan[1]]  =  ", N[ArcTan[1]]]
Print["== 4. special functions (and their common aliases) =="]
Print["  Erf[0]  =  ", Erf[0]]
Print["  Erf[Infinity]  =  ", Erf[Infinity]]
Print["  N[Erf[1]]  =  ", N[Erf[1]]]
Print["  N[Erfc[1]]  =  ", N[Erfc[1]]]
Print["  N[SinIntegral[1]]  =  ", N[SinIntegral[1]]]
Print["  SinIntegral[Infinity]  =  ", SinIntegral[Infinity]]
Print["  N[CosIntegral[1]]  =  ", N[CosIntegral[1]]]
Print["  N[SinhIntegral[1]]  =  ", N[SinhIntegral[1]]]
Print["  N[CoshIntegral[1]]  =  ", N[CoshIntegral[1]]]
Print["  N[ExpIntegralEi[1]]  =  ", N[ExpIntegralEi[1]]]
Print["  N[LogIntegral[2]]  =  ", N[LogIntegral[2]]]
Print["  Sinc[0]  =  ", Sinc[0]]
Print["  N[Sinc[1]]  =  ", N[Sinc[1]]]
Print["  Gamma[5]  =  ", Gamma[5]]
Print["  N[Gamma[1/2]]  =  ", N[Gamma[1/2]]]
Print["  Si[x]  =  ", Si[x]]
Print["  N[Si[1]]  =  ", N[Si[1]]]
Print["  N[Ci[1]]  =  ", N[Ci[1]]]
Print["  N[Ei[1]]  =  ", N[Ei[1]]]
Print["  N[li[2]]  =  ", N[li[2]]]
Print["  N[erf[1]]  =  ", N[erf[1]]]
Print["  N[erfc[1]]  =  ", N[erfc[1]]]
Print["== 5. exact constants and unicode input =="]
Print["  Pi  =  ", Pi]
Print["  E  =  ", E]
Print["  GoldenRatio  =  ", GoldenRatio]
Print["  EulerGamma  =  ", EulerGamma]
Print["  Degree  =  ", Degree]
Print["  Infinity  =  ", Infinity]
Print["  N[2 π]  =  ", N[2 π]]
Print["  √16  =  ", √16]
Print["  45 °  =  ", 45 °]
Print["  3 ≥ 2  =  ", 3 ≥ 2]
Print["  2 × 3  =  ", 2 × 3]
Print["  α + β  =  ", α + β]
Print["== 6. patterns =="]
Print["  MatchQ[3, _Integer]  =  ", MatchQ[3, _Integer]]
Print["  MatchQ[3.5, _Real]  =  ", MatchQ[3.5, _Real]]
Print["  MatchQ[\"hi\", _String]  =  ", MatchQ["hi", _String]]
Print["  MatchQ[{1, 2}, {_, _}]  =  ", MatchQ[{1, 2}, {_, _}]]
Print["  MatchQ[f[1, 2, 3], f[__]]  =  ", MatchQ[f[1, 2, 3], f[__]]]
Print["  MatchQ[3, _?EvenQ]  =  ", MatchQ[3, _?EvenQ]]
Print["  MatchQ[4, _?EvenQ]  =  ", MatchQ[4, _?EvenQ]]
Print["  MatchQ[5, _Integer /; 5 > 3]  =  ", MatchQ[5, _Integer /; 5 > 3]]
Print["  MatchQ[a + b, a | b]  =  ", MatchQ[a + b, a | b]]
Print["  FreeQ[x^2 + 1, y]  =  ", FreeQ[x^2 + 1, y]]
Print["  MemberQ[{1, 2, 3}, 2]  =  ", MemberQ[{1, 2, 3}, 2]]
Print["  {1, 2, 3, 4} /. x_Integer :> x^2  =  ", {1, 2, 3, 4} /. x_Integer :> x^2]
Print["  f[3] /. f[n_] :> n!  =  ", f[3] /. f[n_] :> n!]
Print["  {a, b, c} /. {a -> 1, b -> 2}  =  ", {a, b, c} /. {a -> 1, b -> 2}]
Print["  x + y /. {x -> 1, y -> 2}  =  ", x + y /. {x -> 1, y -> 2}]
Print["  Replace[x^2, x^2 -> 7]  =  ", Replace[x^2, x^2 -> 7]]
Print["  ReplaceAll[{1, 2, 3}, _Integer -> 0]  =  ", ReplaceAll[{1, 2, 3}, _Integer -> 0]]
Print["  ReplaceRepeated[x + x, x -> 1]  =  ", ReplaceRepeated[x + x, x -> 1]]
Print["== 7. function definitions, scoping and attributes =="]
sq[x_] := x^2
Print["  sq[12]  =  ", sq[12]]
fact[0] = 1; fact[n_] := fact[n - 1]*n
Print["  fact[10]  =  ", fact[10]]
grade[s_] := "pass" /; s >= 60; grade[s_] := "fail" /; s < 60
Print["  grade[75]  =  ", grade[75]]
Print["  grade[41]  =  ", grade[41]]
f[x_, y_] := x^y
Print["  f[2, 10]  =  ", f[2, 10]]
Print["  (a compound expression is a legal function argument:"]
Print["  f[a; b]  =  ", f[a; b]]
Clear[f]
Print["  Module[{x = 5}, x^2 + 1]  =  ", Module[{x = 5}, x^2 + 1]]
Print["  Block[{x = 100}, x/2]  =  ", Block[{x = 100}, x/2]]
Print["  With[{y = 3}, y + 1]  =  ", With[{y = 3}, y + 1]]
Print["  #^2 &[7]  =  ", #^2 &[7]]
Print["  Map[#^2 &, {1, 2, 3}]  =  ", Map[#^2 &, {1, 2, 3}]]
SetAttributes[g, Listable]
Print["  g[{1, 2, 3}]  =  ", g[{1, 2, 3}]]
Print["  Attributes[g]  =  ", Attributes[g]]
ClearAttributes[g, Listable]
ClearAll[g]
Print["  Hold[1 + 1]  =  ", Hold[1 + 1]]
Print["  ReleaseHold[Hold[1 + 1]]  =  ", ReleaseHold[Hold[1 + 1]]]
Print["  HoldForm[1 + 1]  =  ", HoldForm[1 + 1]]
Print["  Evaluate[1 + 1]  =  ", Evaluate[1 + 1]]
Print["== 8. lists =="]
Print["  Range[10]  =  ", Range[10]]
Print["  Range[0, 1, 1/4]  =  ", Range[0, 1, 1/4]]
Print["  Range[1, 10, 3]  =  ", Range[1, 10, 3]]
Print["  Range[0, 1, 0.25]  =  ", Range[0, 1, 0.25]]
Print["  Table[i^2, {i, 5}]  =  ", Table[i^2, {i, 5}]]
Print["  Table[{i, j}, {i, 2}, {j, 2}]  =  ", Table[{i, j}, {i, 2}, {j, 2}]]
Print["  Length[{1, 2, 3}]  =  ", Length[{1, 2, 3}]]
Print["  First[{1, 2, 3}]  =  ", First[{1, 2, 3}]]
Print["  Last[{1, 2, 3}]  =  ", Last[{1, 2, 3}]]
Print["  Most[{1, 2, 3}]  =  ", Most[{1, 2, 3}]]
Print["  Rest[{1, 2, 3}]  =  ", Rest[{1, 2, 3}]]
Print["  Take[{1, 2, 3, 4}, 2]  =  ", Take[{1, 2, 3, 4}, 2]]
Print["  Drop[{1, 2, 3, 4}, 2]  =  ", Drop[{1, 2, 3, 4}, 2]]
Print["  Append[{1, 2}, 3]  =  ", Append[{1, 2}, 3]]
Print["  Prepend[{2, 3}, 1]  =  ", Prepend[{2, 3}, 1]]
Print["  Join[{1, 2}, {3, 4}]  =  ", Join[{1, 2}, {3, 4}]]
Print["  Reverse[{1, 2, 3}]  =  ", Reverse[{1, 2, 3}]]
Print["  Flatten[{{1, 2}, {3}}]  =  ", Flatten[{{1, 2}, {3}}]]
Print["  Part[{10, 20, 30}, 2]  =  ", Part[{10, 20, 30}, 2]]
Print["  {10, 20, 30}[[3]]  =  ", {10, 20, 30}[[3]]]
Print["  Sort[{3, 1, 2}]  =  ", Sort[{3, 1, 2}]]
Print["  SortBy[{3, 1, 2}, -# &]  =  ", SortBy[{3, 1, 2}, -# &]]
Print["  DeleteDuplicates[{1, 1, 2, 3, 3}]  =  ", DeleteDuplicates[{1, 1, 2, 3, 3}]]
Print["  Union[{1, 2}, {2, 3}]  =  ", Union[{1, 2}, {2, 3}]]
Print["  Intersection[{1, 2, 3}, {2, 3, 4}]  =  ", Intersection[{1, 2, 3}, {2, 3, 4}]]
Print["  Complement[{1, 2, 3}, {2}]  =  ", Complement[{1, 2, 3}, {2}]]
Print["  Transpose[{{1, 2}, {3, 4}}]  =  ", Transpose[{{1, 2}, {3, 4}}]]
Print["  Total[{1, 2, 3, 4}]  =  ", Total[{1, 2, 3, 4}]]
Print["  Count[{1, 2, 3, 4}, _?EvenQ]  =  ", Count[{1, 2, 3, 4}, _?EvenQ]]
Print["  Position[{1, 2, 3}, 3]  =  ", Position[{1, 2, 3}, 3]]
Print["  Cases[{1, 2, 3, 4}, _?EvenQ]  =  ", Cases[{1, 2, 3, 4}, _?EvenQ]]
Print["  Select[Range[10], EvenQ]  =  ", Select[Range[10], EvenQ]]
Print["  Select[Range[10], # > 5 &]  =  ", Select[Range[10], # > 5 &]]
Print["  Identity[5]  =  ", Identity[5]]
Print["  Thread[f[{1, 2}]]  =  ", Thread[f[{1, 2}]]]
Print["  Accumulate[{1, 2, 3, 4}]  =  ", Accumulate[{1, 2, 3, 4}]]
Print["  Differences[{1, 4, 9, 16}]  =  ", Differences[{1, 4, 9, 16}]]
Print["  Partition[Range[6], 2]  =  ", Partition[Range[6], 2]]
Print["  Riffle[{a, b, c}, 0]  =  ", Riffle[{a, b, c}, 0]]
Print["  Ordering[{3, 1, 2}]  =  ", Ordering[{3, 1, 2}]]
Print["  ConstantArray[0, 3]  =  ", ConstantArray[0, 3]]
Print["  Array[#^2 &, 4]  =  ", Array[#^2 &, 4]]
Print["== 9. functional programming =="]
Print["  Map[f, {1, 2, 3}]  =  ", Map[f, {1, 2, 3}]]
Print["  Apply[Plus, {1, 2, 3}]  =  ", Apply[Plus, {1, 2, 3}]]
Print["  Plus @@ {1, 2, 3}  =  ", Plus @@ {1, 2, 3}]
Print["  f /@ {1, 2, 3}  =  ", f /@ {1, 2, 3}]
Print["  MapAll[f, {1, {2}}]  =  ", MapAll[f, {1, {2}}]]
Print["  MapThread[Plus, {{1, 2}, {3, 4}}]  =  ", MapThread[Plus, {{1, 2}, {3, 4}}]]
Print["  Nest[f, x, 3]  =  ", Nest[f, x, 3]]
Print["  NestList[#^2 &, 2, 3]  =  ", NestList[#^2 &, 2, 3]]
Print["  Fold[Plus, 0, {1, 2, 3, 4}]  =  ", Fold[Plus, 0, {1, 2, 3, 4}]]
Print["  FixedPoint[Cos, 1.0]  =  ", FixedPoint[Cos, 1.0]]
Print["== 10. algebra and polynomials =="]
Print["  Expand[(x + 1)^3]  =  ", Expand[(x + 1)^3]]
Print["  ExpandAll[(x + 1)^3]  =  ", ExpandAll[(x + 1)^3]]
Print["  Factor[x^3 - 6 x^2 + 11 x - 6]  =  ", Factor[x^3 - 6 x^2 + 11 x - 6]]
Print["  Factor[x^2 - 1]  =  ", Factor[x^2 - 1]]
Print["  Together[1/x + 1/y]  =  ", Together[1/x + 1/y]]
Print["  Cancel[(x^2 - 1)/(x - 1)]  =  ", Cancel[(x^2 - 1)/(x - 1)]]
Print["  Collect[x + x^2 + 2 x^2 + 3, x]  =  ", Collect[x + x^2 + 2 x^2 + 3, x]]
Print["  Coefficient[x^2 + 3 x + 2, x]  =  ", Coefficient[x^2 + 3 x + 2, x]]
Print["  CoefficientList[x^2 + 3 x + 2, x]  =  ", CoefficientList[x^2 + 3 x + 2, x]]
Print["  Exponent[x^3 + x, x]  =  ", Exponent[x^3 + x, x]]
Print["  Variables[x^2 + a x + b]  =  ", Variables[x^2 + a x + b]]
Print["  PolynomialQuotient[x^2 - 1, x - 1, x]  =  ", PolynomialQuotient[x^2 - 1, x - 1, x]]
Print["  PolynomialRemainder[x^2 - 1, x - 1, x]  =  ", PolynomialRemainder[x^2 - 1, x - 1, x]]
Print["  PolynomialQuotientRemainder[x^2 + 1, x - 1, x]  =  ", PolynomialQuotientRemainder[x^2 + 1, x - 1, x]]
Print["  PolynomialGCD[x^2 - 1, x^2 - 2 x + 1]  =  ", PolynomialGCD[x^2 - 1, x^2 - 2 x + 1]]
Print["  x^m x^n  =  ", x^m x^n]
Print["  x^n/x  =  ", x^n/x]
Print["  Apart[1/(x^2 - 1), x]  =  ", Apart[1/(x^2 - 1), x]]
Print["  Simplify[(x^2 - 1)/(x - 1)]  =  ", Simplify[(x^2 - 1)/(x - 1)]]
Print["  Simplify[Sqrt[x^2], x > 0]  =  ", Simplify[Sqrt[x^2], x > 0]]
Print["  Steps[Simplify[(x^2 - 1)/(x - 1)]]  =  ", Steps[Simplify[(x^2 - 1)/(x - 1)]]]
Print["  Steps[Factor[x^2 - 1]]  =  ", Steps[Factor[x^2 - 1]]]
Print["== 11. calculus =="]
Print["  D[x^3 + Sin[x], x]  =  ", D[x^3 + Sin[x], x]]
Print["  D[Sin[x]^2, x]  =  ", D[Sin[x]^2, x]]
Print["  D[Exp[x^2], x]  =  ", D[Exp[x^2], x]]
Print["  D[x^4, {x, 2}]  =  ", D[x^4, {x, 2}]]
Print["  Integrate[1/x, x]  =  ", Integrate[1/x, x]]
Print["  Integrate[x^2, x]  =  ", Integrate[x^2, x]]
Print["  Integrate[Sin[x], x]  =  ", Integrate[Sin[x], x]]
Print["  Integrate[x^2, {x, 0, 1}]  =  ", Integrate[x^2, {x, 0, 1}]]
Print["  Integrate[Sin[x]/x, x]  =  ", Integrate[Sin[x]/x, x]]
Print["  Integrate[Sin[2 x]/x, x]  =  ", Integrate[Sin[2 x]/x, x]]
Print["  Integrate[Cos[x]/x, x]  =  ", Integrate[Cos[x]/x, x]]
Print["  Integrate[Exp[x]/x, x]  =  ", Integrate[Exp[x]/x, x]]
Print["  Integrate[1/Log[x], x]  =  ", Integrate[1/Log[x], x]]
Print["  Integrate[Exp[-x^2], x]  =  ", Integrate[Exp[-x^2], x]]
Print["  Integrate[Sin[x]/x, {x, 0, Infinity}]  =  ", Integrate[Sin[x]/x, {x, 0, Infinity}]]
Print["  N[Integrate[Sin[x]/x, {x, 0, Pi}]]  =  ", N[Integrate[Sin[x]/x, {x, 0, Pi}]]]
Print["  D[Si[x], x]  =  ", D[Si[x], x]]
Print["  D[SinIntegral[x], x]  =  ", D[SinIntegral[x], x]]
Print["  D[Erf[x], x]  =  ", D[Erf[x], x]]
Print["  D[Sinc[x], x]  =  ", D[Sinc[x], x]]
Print["  Series[Exp[x], {x, 0, 4}]  =  ", Series[Exp[x], {x, 0, 4}]]
Print["  Normal[Series[Exp[x], {x, 0, 4}]]  =  ", Normal[Series[Exp[x], {x, 0, 4}]]]
Print["  Normal[Series[Cos[x], {x, 0, 6}]]  =  ", Normal[Series[Cos[x], {x, 0, 6}]]]
Print["  Integrate[Sqrt[x], x]  =  ", Integrate[Sqrt[x], x]]
Print["  Integrate[x^n, x]  =  ", Integrate[x^n, x]]
Print["  D[f[x], x]  =  ", D[f[x], x]]
Print["  D[Abs[x], x]  =  ", D[Abs[x], x]]
Print["  Series[Sin[x], {x, 0, 5}]  =  ", Series[Sin[x], {x, 0, 5}]]
Print["  Normal[Series[Sin[x], {x, 0, 5}]]  =  ", Normal[Series[Sin[x], {x, 0, 5}]]]
Print["  Limit[Sin[x]/x, x -> 0]  =  ", Limit[Sin[x]/x, x -> 0]]
Print["  Limit[(x^2 - 1)/(x - 1), x -> 1]  =  ", Limit[(x^2 - 1)/(x - 1), x -> 1]]
Print["  Limit[1/x, x -> Infinity]  =  ", Limit[1/x, x -> Infinity]]
Print["  Integrate[1/(1 + x^2), x]  =  ", Integrate[1/(1 + x^2), x]]
Print["  Integrate[x Sin[x], x]  =  ", Integrate[x Sin[x], x]]
Print["  Integrate[x^2 Log[x], x]  =  ", Integrate[x^2 Log[x], x]]
Print["  Sum[i, {i, 1, n}]  =  ", Sum[i, {i, 1, n}]]
Print["  Sum[1/n^2, {n, 1, Infinity}]  =  ", Sum[1/n^2, {n, 1, Infinity}]]
Print["  Steps[D[Sin[x]^2, x]]  =  ", Steps[D[Sin[x]^2, x]]]
Print["  Steps[Integrate[x Sin[x], x]]  =  ", Steps[Integrate[x Sin[x], x]]]
Print["  Steps[Limit[Sin[x]/x, x -> 0]]  =  ", Steps[Limit[Sin[x]/x, x -> 0]]]
Print["== 12. equations =="]
Print["  Solve[2 x + 3 == 7, x]  =  ", Solve[2 x + 3 == 7, x]]
Print["  Solve[x^2 - 4 == 0, x]  =  ", Solve[x^2 - 4 == 0, x]]
Print["  Solve[x^2 - 2 == 0, x]  =  ", Solve[x^2 - 2 == 0, x]]
Print["  Solve[x^2 + 4 == 0, x]  =  ", Solve[x^2 + 4 == 0, x]]
Print["  Solve[x^2 + x + 1 == 0, x]  =  ", Solve[x^2 + x + 1 == 0, x]]
Print["  Solve[a x == b, x]  =  ", Solve[a x == b, x]]
Print["  Solve[a x^2 + b x + c == 0, x]  =  ", Solve[a x^2 + b x + c == 0, x]]
Print["  Solve[x^3 - 6 x^2 + 11 x - 6 == 0, x]  =  ", Solve[x^3 - 6 x^2 + 11 x - 6 == 0, x]]
Print["  Solve[x^4 - 5 x^2 + 4 == 0, x]  =  ", Solve[x^4 - 5 x^2 + 4 == 0, x]]
Print["  Solve[x^4 + x^2 - 1 == 0, x]  =  ", Solve[x^4 + x^2 - 1 == 0, x]]
Print["  Solve[{x + y == 5, x - y == 1}, {x, y}]  =  ", Solve[{x + y == 5, x - y == 1}, {x, y}]]
Print["  Solve[{x + y + z == 6, x - y == 0, z == 2}, {x, y, z}]  =  ", Solve[{x + y + z == 6, x - y == 0, z == 2}, {x, y, z}]]
Print["  Solve[{x + y == 1, x + y == 2}, {x, y}]  =  ", Solve[{x + y == 1, x + y == 2}, {x, y}]]
Print["  NSolve[x^3 - 6 x^2 + 11 x - 6 == 0, x]  =  ", NSolve[x^3 - 6 x^2 + 11 x - 6 == 0, x]]
Print["  NSolve[x^2 + 1 == 0, x]  =  ", NSolve[x^2 + 1 == 0, x]]
Print["  FindRoot[x^2 - 2 == 0, {x, 1}]  =  ", FindRoot[x^2 - 2 == 0, {x, 1}]]
Print["  FindRoot[Cos[x] == x, {x, 1}]  =  ", FindRoot[Cos[x] == x, {x, 1}]]
Print["  Steps[Solve[x^2 - 3 x + 2 == 0, x]]  =  ", Steps[Solve[x^2 - 3 x + 2 == 0, x]]]
Print["== 13. linear algebra =="]
m = {{2, 1}, {1, 3}}
Print["  m  =  ", m]
Print["  Det[m]  =  ", Det[m]]
Print["  Inverse[m]  =  ", Inverse[m]]
Print["  Transpose[m]  =  ", Transpose[m]]
Print["  MatrixPower[m, 2]  =  ", MatrixPower[m, 2]]
Print["  MatrixPower[m, -1]  =  ", MatrixPower[m, -1]]
Print["  RowReduce[m]  =  ", RowReduce[m]]
Print["  MatrixRank[m]  =  ", MatrixRank[m]]
Print["  LinearSolve[m, {5, 10}]  =  ", LinearSolve[m, {5, 10}]]
Print["  Dot[{1, 2}, {3, 4}]  =  ", Dot[{1, 2}, {3, 4}]]
Print["  {1, 2} . {3, 4}  =  ", {1, 2} . {3, 4}]
Print["  IdentityMatrix[3]  =  ", IdentityMatrix[3]]
Print["  DiagonalMatrix[{1, 2, 3}]  =  ", DiagonalMatrix[{1, 2, 3}]]
Print["  Det[{{1, 2}, {2, 4}}]  =  ", Det[{{1, 2}, {2, 4}}]]
Print["== 14. strings =="]
Print["  \"r\" <> \"Math\"  =  ", "r" <> "Math"]
Print["  StringJoin[\"a\", \"b\", \"c\"]  =  ", StringJoin["a", "b", "c"]]
Print["  StringLength[\"Mathematica-style\"]  =  ", StringLength["Mathematica-style"]]
Print["  StringTake[\"abcdef\", 3]  =  ", StringTake["abcdef", 3]]
Print["  StringDrop[\"abcdef\", 3]  =  ", StringDrop["abcdef", 3]]
Print["  Characters[\"abc\"]  =  ", Characters["abc"]]
Print["  ToUpperCase[\"rmath\"]  =  ", ToUpperCase["rmath"]]
Print["  ToLowerCase[\"RMATH\"]  =  ", ToLowerCase["RMATH"]]
Print["  ToString[123]  =  ", ToString[123]]
Print["  ToExpression[\"1 + 2\"]  =  ", ToExpression["1 + 2"]]
Print["  StringSplit[\"a,b,c\", \",\"]  =  ", StringSplit["a,b,c", ","]]
Print["  StringReplace[\"abc\", \"b\" -> \"X\"]  =  ", StringReplace["abc", "b" -> "X"]]
Print["  StringMatchQ[\"hello\", \"h*\"]  =  ", StringMatchQ["hello", "h*"]]
Print["== 15. logic, comparisons and predicates =="]
Print["  3 > 2  =  ", 3 > 2]
Print["  3 < 2  =  ", 3 < 2]
Print["  3 >= 3  =  ", 3 >= 3]
Print["  3 <= 2  =  ", 3 <= 2]
Print["  3 == 3  =  ", 3 == 3]
Print["  3 != 4  =  ", 3 != 4]
Print["  3 === 3  =  ", 3 === 3]
Print["  3 =!= 4  =  ", 3 =!= 4]
Print["  True && False  =  ", True && False]
Print["  True || False  =  ", True || False]
Print["  !True  =  ", !True]
Print["  Not[False]  =  ", Not[False]]
Print["  And[True, True]  =  ", And[True, True]]
Print["  Or[False, True]  =  ", Or[False, True]]
Print["  Boole[3 > 2]  =  ", Boole[3 > 2]]
Print["  TrueQ[1 > 0]  =  ", TrueQ[1 > 0]]
Print["  IntegerQ[3]  =  ", IntegerQ[3]]
Print["  NumberQ[3.5]  =  ", NumberQ[3.5]]
Print["  NumericQ[Pi]  =  ", NumericQ[Pi]]
Print["  ListQ[{1}]  =  ", ListQ[{1}]]
Print["  AtomQ[x]  =  ", AtomQ[x]]
Print["  EvenQ[4]  =  ", EvenQ[4]]
Print["  OddQ[3]  =  ", OddQ[3]]
Print["  PrimeQ[97]  =  ", PrimeQ[97]]
Print["  Prime[25]  =  ", Prime[25]]
Print["== 16. control flow and iteration =="]
Print["  If[2 > 1, yes, no]  =  ", If[2 > 1, yes, no]]
Print["  Which[1 > 2, a, 3 > 2, b]  =  ", Which[1 > 2, a, 3 > 2, b]]
Print["  Switch[2, 1, one, 2, two]  =  ", Switch[2, 1, one, 2, two]]
Print["  CompoundExpression[1 + 1, 2 + 2]  =  ", CompoundExpression[1 + 1, 2 + 2]]
Do[Print["    Do iteration ", i], {i, 3}]
i = 0; While[i < 3, i = i + 1]; Print["    While loop ended with i = ", i]
For[i = 1, i <= 3, i = i + 1, Print["    For iteration ", i]]
Print["    Catch/Throw caught ", Catch[Throw[42]]]
Reap[Sow[7]; Sow[8]]
Print["  Catch[Throw[42]]  =  ", Catch[Throw[42]]]
retf[x_] := (If[x > 0, Return[positive]]; nonpositive)
Print["  retf[5]  =  ", retf[5]]
Print["  retf[-1]  =  ", retf[-1]]
Print["  Sequence[1, 2]  =  ", Sequence[1, 2]]
Print["  Piecewise[{{1, True}}, 0]  =  ", Piecewise[{{1, True}}, 0]]
Print["  Quiet[1/0]  =  ", Quiet[1/0]]
Print["== 17. information and utilities =="]
Print["  Head[3]  =  ", Head[3]]
Print["  Head[{1, 2}]  =  ", Head[{1, 2}]]
Print["  Head[f[x]]  =  ", Head[f[x]]]
Print["  Length[Names[\"S*\"]] > 0  =  ", Length[Names["S*"]] > 0]
Print["  Count[Names[\"*\"], _]  =  ", Count[Names["*"], _]]
Print["  Attributes[Plus]  =  ", Attributes[Plus]]
Print["  Attributes[D]  =  ", Attributes[D]]
Print["  Options[Plot]  =  ", Options[Plot]]
Print["  ValueQ[m]  =  ", ValueQ[m]]
Print["  Keys[<|a -> 1, b -> 2|>]  =  ", Keys[<|a -> 1, b -> 2|>]]
Print["  Lookup[<|a -> 1, b -> 2|>, b]  =  ", Lookup[<|a -> 1, b -> 2|>, b]]
Print["  $Version  =  ", $Version]
Print["  Trace[(1 + 2)*(3 + 4)]  =  ", Trace[(1 + 2)*(3 + 4)]]
Print["  Definition[sq]  =  ", Definition[sq]]
Print["  FullForm[1/2]  =  ", FullForm[1/2]]
Print["  InputForm[x^2]  =  ", InputForm[x^2]]
Print["  TeXForm[1/2]  =  ", TeXForm[1/2]]
Print["  ToString[1/2]  =  ", ToString[1/2]]
Print["  AbsoluteTiming[Total[Range[1000]]]  =  ", AbsoluteTiming[Total[Range[1000]]]]
Print["  1/0  =  ", 1/0]
Print["  0/0  =  ", 0/0]
Print["  Infinity + 1  =  ", Infinity + 1]
Print["  1/Infinity  =  ", 1/Infinity]
Print["  0*Infinity  =  ", 0*Infinity]
Print["  Infinity - Infinity  =  ", Infinity - Infinity]
Print["  Chop[0.0000001]  =  ", Chop[0.0000001]]
Print["== 18. random numbers =="]
SeedRandom[42]
Print["  RandomInteger[6]  =  ", RandomInteger[6]]
Print["  RandomReal[]  =  ", RandomReal[]]
Print["  RandomChoice[{a, b, c}]  =  ", RandomChoice[{a, b, c}]]
