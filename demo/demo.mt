Print["== 19. file input / modify / output =="]
Print["  Import[\"demo/data.csv\"]  =  ", Import["demo/data.csv"]]
doubled = Map[2 # &, Import["demo/data.csv"]]
Print["  doubled  =  ", doubled]
Export["demo/data_doubled.csv", doubled]
Print["  Import[\"demo/data_doubled.csv\"]  =  ", Import["demo/data_doubled.csv"]]
Print["  FileExistsQ[\"demo/data_doubled.csv\"]  =  ", FileExistsQ["demo/data_doubled.csv"]]
Put["demo/saved.txt", x^2 + 2 x + 1]
Print["  Get[\"demo/saved.txt\"]  =  ", Get["demo/saved.txt"]]
Put[42, "demo/saved2.txt"]
Print["  Get[\"demo/saved2.txt\"]  =  ", Get["demo/saved2.txt"]]
PutAppend[43, "demo/saved2.txt"]
Print["  Import[\"demo/saved2.txt\"]  =  ", Import["demo/saved2.txt"]]
Print["  Directory[]  =  ", Directory[]]
DeleteFile["demo/saved2.txt"]

Print["== 21. calculus, cross-checked in Lean =="]
Print["  Select any cell below and press \u2325\u2318V (Help > Verify in Lean):"]
Print["  the result is translated to a Lean statement and proved with Mathlib."]
Print["  Quotients, logarithms and roots are proved under their non-zero side"]
Print["  conditions, which the generated statement carries as hypotheses."]
Print["  D[3 x^4, x]  =  ", D[3 x^4, x]]
Print["  D[x^3 + Sin[x], x]  =  ", D[x^3 + Sin[x], x]]
Print["  D[Exp[x^2], x]  =  ", D[Exp[x^2], x]]
Print["  D[Sin[x]^2, x]  =  ", D[Sin[x]^2, x]]
Print["  D[Sin[x]/x, x]  =  ", D[Sin[x]/x, x]]
Print["  D[Log[x], x]  =  ", D[Log[x], x]]
Print["  D[Sqrt[x], x]  =  ", D[Sqrt[x], x]]
Print["  D[Exp[x] Log[x], x]  =  ", D[Exp[x] Log[x], x]]
Print["  D[Log[x^2 + 1], x]  =  ", D[Log[x^2 + 1], x]]
Print["  Integrate[x^2, {x, 0, 1}]  =  ", Integrate[x^2, {x, 0, 1}]]
Print["  Integrate[x^3, {x, 0, 2}]  =  ", Integrate[x^3, {x, 0, 2}]]
Print["  Integrate[1/x, x]  =  ", Integrate[1/x, x]]
Print["  Integrate[Exp[-x^2], x]  =  ", Integrate[Exp[-x^2], x]]
Print["  Series[Exp[x], {x, 0, 4}]  =  ", Series[Exp[x], {x, 0, 4}]]
Print["  Normal[Series[Cos[x], {x, 0, 6}]]  =  ", Normal[Series[Cos[x], {x, 0, 6}]]]

Print["== 22. verifying in Lean =="]
Print["  The Lean panel (\u21e7\u2318L, or the Lean button in the ribbon) checks"]
Print["  Lean 4 directly \u2014 Mathlib is imported for you \u2014 and Verify the last"]
Print["  cell (\u2325\u2318V) shows the generated statement and the verdict."]
Print["  Verified claims are cached, so re-checking a cell is instant."]
Print["  Machine approximations (N[...]), complex numbers, GCD/LCM and bare"]
Print["  non-claims are refused with the reason shown, rather than guessed."]
Print["  1/2 + 1/3 == 5/6  =  ", 1/2 + 1/3 == 5/6]
Print["  2^10 == 1024  =  ", 2^10 == 1024]
Print["  Abs[-7] == 7  =  ", Abs[-7] == 7]
Print["  Sqrt[8] == 2 Sqrt[2]  =  ", Sqrt[8] == 2 Sqrt[2]]
Print["  20! == 2432902008176640000  =  ", 20! == 2432902008176640000]
Print["  Expand[(x + 1)^3] == 1 + 3 x + 3 x^2 + x^3  =  ", Expand[(x + 1)^3] == 1 + 3 x + 3 x^2 + x^3]
Print["  GCD[24, 36] == 12  =  ", GCD[24, 36] == 12]
Print["  Integrate[x^2, {x, 0, 1}] == 1/3  =  ", Integrate[x^2, {x, 0, 1}] == 1/3]
Print["  D[x^3, x] == 3 x^2  =  ", D[x^3, x] == 3 x^2]
Print["  Length[Names[\"*\"]] > 0  =  ", Length[Names["*"]] > 0]

Print["== 23. the notebook itself =="]
Print["  Ribbon: Evaluate, Evaluate All, New, Open..., Save, Reset kernel,"]
Print["          Save last plot as SVG, zoom, Standard/Traditional form,"]
Print["          Report a Bug, Lean, Harness, Help"]
